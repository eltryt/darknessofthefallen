{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "darknessofthefallen-backend",
	"main": "src/cloudflare-worker.mjs",
	"compatibility_date": "2026-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"preview_urls": false,
	"vars": {
		"RAID_HELPER_CHANNEL_ID": "1550997172982382723",
		"RAID_HELPER_TEMPLATE_ID": "wowforever",
		"VAPID_PUBLIC_KEY": "BJ6BIFuCEgeq9EDebLvLmOjCF08fqEqwpaTGFWBYeIlJHqPTE1XgEpnSfCE4bexyjTomorll5Itv69MXy3868fg",
		"APP_ORIGIN": "https://darknessofthefallen.com",
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	// Each deploy's id marks the pages, so the app's service worker renews its code cache.
	"version_metadata": { "binding": "CF_VERSION_METADATA" },
	"durable_objects": {
		"bindings": [{ "name": "GUILD", "class_name": "Guild" }],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Guild"] }],
	"rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
	"observability": { "enabled": false },
}

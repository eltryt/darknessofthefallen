{
	"name": "darkness-of-the-fallen",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "node --watch src/server.mjs",
		"start": "node src/server.mjs",
		"test": "node --test tests/*.test.mjs",
		"build": "node scripts/build.mjs",
		"backup": "node scripts/backup.mjs",
		"preview": "node scripts/preview.mjs",
		"export:showcase": "node scripts/export-showcase.mjs",
		"dev:backend": "wrangler dev --local --var APP_ORIGIN:http://localhost:8787",
		"build:backend": "wrangler deploy --dry-run --outdir .wrangler/build",
		"deploy:backend": "wrangler deploy",
		"test:backend": "node --test tests/cloudflare/*.test.mjs",
		"restore": "node scripts/restore.mjs",
		"format": "prettier --write \"{public,src,scripts,tests}/**/*.{js,mjs,css,html}\" \"*.json\" \"*.jsonc\" \".github/workflows/*.yml\"",
		"format:check": "prettier --check \"{public,src,scripts,tests}/**/*.{js,mjs,css,html}\" \"*.json\" \"*.jsonc\" \".github/workflows/*.yml\""
	},
	"devDependencies": {
		"miniflare": "5.20261006.0-alpha",
		"prettier": "3.9.10",
		"wrangler": "4.148.0"
	}
}

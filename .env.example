PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=data/guild.sqlite
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# JSON mapping Discord role IDs to web roles: member,raider,raid_leader,officer,leader
DISCORD_ROLE_MAP={}
# Explicit initial leader Discord ID; never auto-promote the first visitor
DISCORD_LEADER_ID=
# Webhook belonging ONLY to a private recruitment channel
DISCORD_RECRUITMENT_WEBHOOK=
# Notifications are opt-in. Leave false to store applications only in the website.
RECRUITMENT_NOTIFICATIONS_ENABLED=false

# Raid-Helper server key from /apikey; never use a Discord personal token.
RAID_HELPER_API_KEY=
RAID_HELPER_CHANNEL_ID=1550997172982382723
# Official standard WoW Classic template; may be changed to the guild's chosen template.
RAID_HELPER_TEMPLATE_ID=599020379125841954
